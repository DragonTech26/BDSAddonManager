; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BDS Addon Manager"
config/description="Manage addons for your Bedrock Dedicated Servers"
config/version="2.2.0"
run/main_scene="uid://d16hxw7mmxo1y"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
boot_splash/show_image=false
config/icon="uid://o68a4ig6fr4"
config/windows_native_icon="res://assets/graphics/icons/windows_icon.ico"

[audio]

driver/driver="Dummy"

[autoload]

WindowSize="*res://src/autoload/window_size.gd"
LoadSettings="*res://src/autoload/load_settings.gd"
Global="*res://src/autoload/global.gd"
LoadRecentWorlds="*res://src/autoload/load_recent_worlds.gd"
AlertManager="*res://src/autoload/alert_manager.gd"
HiddenPackPrefixes="*uid://dvur8wlpd5vm4"
CheckServerPing="*uid://cpk6ylp46wout"
Themes="*res://src/autoload/themes.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=640
window/energy_saving/keep_screen_on=false

[dotnet]

project/assembly_name="BDS Addon Manager"

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
shader_compiler/shader_cache/enabled=false
